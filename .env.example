# Copiez ce fichier en .env.local pour le développement (ne jamais committer .env*)

# Obligatoire en production (Vercel / hébergeur)
# URL Postgres (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Optionnel mais recommandé en production
# Chaîne aléatoire longue pour signer les cookies de session
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# PIN admin initial est dans la base (table loyalty_settings).
# Valeur de démo après migration : 2468 — changez-la dans Admin → Règles.
